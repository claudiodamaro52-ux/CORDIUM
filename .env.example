# ── Monetizacao ────────────────────────────────────────────
# Chave PIX para receber pagamentos
CHAVE_PIX=claudio@damaro.com.br

# Valor cobrado por hora de uso do SIM9
VALOR_POR_HORA=10.0

# Senha usada pelo admin para emitir tokens (troque antes de subir para producao)
ADMIN_SECRET=cordium-admin-local

# ── E-mail (deixe vazio para modo console/local) ───────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=contato@cordium.com.br
EMAIL_ADMIN=claudio@damaro.com.br

